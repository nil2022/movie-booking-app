# Database Config
DB_URL=
CORS_ORIGIN=http://localhost:5173
SERVER_PORT=4000

# Email Config
EMAIL_HOST_NAME=
EMAIL_PORT_NUMBER=
EMAIL_AUTH_SECURE=
EMAIL_AUTH_USER=
EMAIL_AUTH_PASSWORD=
EMAIL_FROM_USER=

# Server / Security Config
BACKEND_URL=
NODE_ENV=dev
# Reverse proxy hops in front of the app (e.g. 1 on Render/Heroku/Vercel) so rate limiting sees the real client IP
TRUST_PROXY=0
# Must be a long random string (>= 32 chars), e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=2h
